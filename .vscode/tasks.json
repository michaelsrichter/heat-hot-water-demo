{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend",
      "detail": "Run Vite",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "stack",
        "reveal": "always"
      },
      "icon": { "id": "browser", "color": "terminal.ansiBlue" },
      "problemMatcher": []
    },
    {
      "label": "backend-api",
      "detail": "Run FastAPI",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "stack",
        "reveal": "always"
      },
      "icon": { "id": "server", "color": "terminal.ansiYellow" },
      "problemMatcher": []
    },
    {
      "label": "Run All",
      "dependsOn": ["frontend", "backend-api"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test",
      "detail": "Run all tests with coverage (make test)",
      "type": "shell",
      "command": "make test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "detail": "Lint + format check (make lint)",
      "type": "shell",
      "command": "make lint",
      "problemMatcher": []
    },
    {
      "label": "deploy",
      "detail": "azd up (make deploy)",
      "type": "shell",
      "command": "make deploy",
      "problemMatcher": []
    }
  ]
}
