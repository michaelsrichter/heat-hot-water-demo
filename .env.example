# ---------------------------------------------------------------------------
# Example environment file. This template ships with no app yet, so there are
# no concrete variables — copy this pattern into backend/.env.example and
# frontend/.env.example once scaffolded, and fill in NON-SECRET values only.
#
# Secrets (keys, connection strings, passwords) must NEVER live here or in any
# .env file. Cloud resources are reached via Managed Identity (`az login`
# locally, system-assigned identity in Azure). See SECURITY.md and
# .github/skills/eps-demo-cost-security/SKILL.md.
#
# Typical non-secret values that DO belong here once there's an app:
#   - Service endpoints/URLs (e.g. Storage/Cosmos/AI Foundry account URLs)
#   - Feature flags (e.g. FAKE_AI=1 for local/CI deterministic AI)
#   - Public, non-sensitive config (region, app name)
# ---------------------------------------------------------------------------

# Exact browser origin allowed to call the local API.
FRONTEND_ORIGIN=http://localhost:5173

# Optional override for a built frontend served by FastAPI.
FRONTEND_STATIC_DIR=

# ADLS Gen2 values from the Azure deployment.
ADLS_ACCOUNT_URL=
ADLS_CONTAINER=heat-hot-water
ADLS_MANIFEST_PATH=current/manifest.json

# The Practice build is deterministic and does not call an AI model.
FAKE_AI=1

# Optional read-only Strategy Mosaic MCP connection. The server requires the
# organization's OAuth setup and a user with the Use Mosaic MCP Server privilege.
STRATEGY_MCP_URL=

# Use "mock" for a clearly labeled MCP-shaped demo response. Use "snapshot"
# until the HPD Mosaic model is certified and visible through Strategy MCP.
STRATEGY_MCP_MODE=mock

# Set this only after the hpd-review-agent is deployed. The endpoint is generated
# by azd as AGENT_HPD_REVIEW_AGENT_RESPONSES_ENDPOINT.
FOUNDRY_AGENT_ENDPOINT=
