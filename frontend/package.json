{
  "name": "heat-hot-water-demo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "docs:build": "node scripts/build-docs.mjs",
    "dev": "npm run docs:build && vite --host 0.0.0.0",
    "build": "npm run docs:build && tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "format": "prettier --check .",
    "test": "npm run docs:build && vitest run",
    "test:coverage": "npm run docs:build && vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
